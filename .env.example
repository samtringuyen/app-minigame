NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Postgres (required)
DATABASE_URL=postgres://minigame:minigame@localhost:5432/minigame

# Redis (optional — the API boots and serves traffic without it)
REDIS_URL=redis://localhost:6379

# JWT secrets must be at least 32 characters. Generate unique values per environment.
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Highest accepted session score (inclusive). Scores above this are rejected.
MAX_SCORE=1000000

# Comma-separated origins, or * for local development
CORS_ORIGIN=*
